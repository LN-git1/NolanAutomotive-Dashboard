# ---------------------------------------------------------------------------
# Nolan Automotive Dashboard — environment variables
# Copy to .env.local for local development. Never commit the filled-in file.
# ---------------------------------------------------------------------------

# --- Authentication ---------------------------------------------------------
# The single owner account. There is no user table; these ARE the credentials.
ADMIN_USERNAME=owner
ADMIN_PASSWORD=change-me-to-something-long

# Signing secret for the session cookie (NOT a credential).
# Generate with: openssl rand -base64 32
SESSION_SECRET=

# --- Database ---------------------------------------------------------------
# POOLED connection (Supavisor, port 6543). Used for all runtime queries.
# Must include ?pgbouncer=true
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-eu-central-1.pooler.supabase.com:6543/postgres?pgbouncer=true

# DIRECT connection (port 5432). Used ONLY by drizzle-kit generate/migrate.
# Migrations break against the pooler — see drizzle.config.ts.
DIRECT_DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-eu-central-1.pooler.supabase.com:5432/postgres

# --- Supabase Storage -------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co

# Service-role key. SERVER ONLY — bypasses row-level security.
# Never prefix this with NEXT_PUBLIC_ and never expose it to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# --- Development tools ------------------------------------------------------
# Enables the Template Mapper at /dev/template-mapper.
# MUST be unset (or false) in production: the mapper writes a JSON file to disk,
# which a serverless filesystem cannot do.
TEMPLATE_MAPPER=false
