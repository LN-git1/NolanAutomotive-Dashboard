# ---------------------------------------------------------------------------
# Nolan Automotive Dashboard — environment variables
#
# Local development:  copy to .env.local
# Production:         set these in Vercel (Production AND Preview), and keep a
#                     copy in .env.production.local for running migrations.
#
# Never commit a filled-in file. Note that NONE of these are prefixed
# NEXT_PUBLIC_ — that prefix inlines a value into the client bundle at BUILD
# time, which would both leak the secret and read as "not set" at runtime.
# ---------------------------------------------------------------------------

# --- Authentication ---------------------------------------------------------
# The single owner account. There is no user table; these ARE the credentials.
# If either is missing, /api/auth/login returns a 500 with a clear message
# rather than silently rejecting every password.
ADMIN_USERNAME=owner
ADMIN_PASSWORD=change-me-to-something-long

# Signing secret for the session cookie (NOT a credential).
# Generate with: openssl rand -base64 32
SESSION_SECRET=

# --- Database (Supabase, used as a managed Postgres host only) --------------
# POOLED connection (Supavisor, port 6543). Used for all runtime queries.
# Must include ?pgbouncer=true
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-eu-west-1.pooler.supabase.com:6543/postgres?pgbouncer=true

# DIRECT connection (port 5432). Used ONLY by migrations and seeding.
# The pooler breaks DDL and prepared statements — scripts/migrate.ts refuses
# port 6543 outright rather than failing partway through a migration.
DIRECT_DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-eu-west-1.pooler.supabase.com:5432/postgres

# --- File storage (Cloudflare R2) -------------------------------------------
# Server-only. These credentials can read and write every object in both
# buckets, so they must never reach the browser.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ATTACHMENTS_BUCKET=nolan-attachments
R2_INVOICES_BUCKET=nolan-invoices

# --- Cron -------------------------------------------------------------------
# Bearer token the daily keep-alive cron must present. Vercel Cron sends this
# automatically when the variable is set. Without it the health endpoint is
# open (fine locally); with it, anything lacking the token gets a 404.
# Generate with: openssl rand -base64 32
CRON_SECRET=

# --- Development tools ------------------------------------------------------
# Enables the Template Mapper at /dev/template-mapper.
# MUST be unset in production: the mapper writes a JSON file into the source
# tree, which a serverless filesystem cannot do.
TEMPLATE_MAPPER=false
