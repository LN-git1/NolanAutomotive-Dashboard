{
  "$schema": "node_modules/wrangler/config-schema.json",

  // Must match the Worker name in the Cloudflare dashboard, or Workers Builds
  // fails with a confusing name-mismatch error.
  "name": "nolan-automotive-dashboard",
  "main": ".open-next/worker.js",

  "compatibility_date": "2025-08-01",
  "compatibility_flags": [
    // Next.js server code needs Node built-ins (crypto, buffer, streams).
    "nodejs_compat",
    // Lets the Worker fetch public URLs (R2 presigned URLs, and its own assets)
    // rather than short-circuiting them internally.
    "global_fetch_strictly_public"
  ],

  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },

  "observability": {
    "enabled": true
  },

  /**
   * NOTE: the Supabase keep-alive cron is NOT configured here yet.
   *
   * Cloudflare cron triggers invoke a `scheduled()` export on the Worker, but
   * the entrypoint is generated by OpenNext and only exports `fetch`. Declaring
   * a trigger with no handler would deploy a cron that silently does nothing —
   * worse than no cron, because it would look configured. Added once the first
   * deploy is green, either via a wrapper entrypoint or an external pinger
   * against /api/health, which already exists and is secured by CRON_SECRET.
   *
   * Until then: Supabase pauses a free project after ~7 idle days.
   */

  /**
   * Stamping an invoice embeds and subsets two TrueType fonts, which is far more
   * CPU than the 10ms the free plan allows — this is the reason the project is
   * on Workers Paid. 30s is the paid default and ample; it bounds a hung request
   * rather than enabling a slow one.
   */
  "limits": {
    "cpu_ms": 30000
  }
}
